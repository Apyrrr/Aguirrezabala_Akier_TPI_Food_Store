# Copiar este archivo como .env y completar los valores.
# El archivo .env no se sube al repositorio ni se comparte (está en .gitignore).

# Base de datos. PostgreSQL:
DATABASE_URL=postgresql://postgres:completar@localhost:5432/foodstore_db
# Para desarrollo local sin PostgreSQL se acepta SQLite:
# DATABASE_URL=sqlite:///./foodstore.db

# JWT: clave de al menos 32 caracteres aleatorios.
# Para generarla: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen del frontend permitido en CORS (con credenciales)
FRONTEND_ORIGIN=http://localhost:5173
